{
  "name": "mixai",
  "version": "0.3.0",
  "description": "Controle da Soundcraft Ui16 por IA (servidor MCP)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "console": "node dist/console.js",
    "console:mock": "node dist/console.js --mock",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "start:mock": "node dist/index.js --mock",
    "console:lab": "node dist/console.js --lab",
    "start:lab": "node dist/index.js --lab"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "rxjs": "^7.8.2",
    "soundcraft-ui-connection": "7.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "mixai": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  }
}
