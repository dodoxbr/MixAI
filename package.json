{
  "name": "mixai",
  "version": "0.7.0",
  "description": "Controle da Soundcraft Ui16 por IA (servidor \u00fanico + MCP)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "console": "node dist/console.js",
    "console:f0": "node dist/console.js --real --readonly",
    "preflight:f0": "node dist/f0-route-preflight-cli.js",
    "observe:f0": "node dist/f0-observer-cli.js",
    "console:mock": "node dist/console.js --mock",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "start:mock": "node dist/index.js --mock",
    "console:lab": "node dist/console.js --lab",
    "start:lab": "node dist/index.js --lab",
    "serve": "node dist/serve.js",
    "serve:lab": "node dist/serve.js --lab",
    "serve:supervised-aux": "node dist/supervised-first-write-cli.js",
    "serve:mock": "node dist/serve.js --mock",
    "serve:real": "node dist/serve.js --real",
    "pin": "node dist/pin.js",
    "build:web": "npm --prefix web run build",
    "test:web": "npm --prefix web test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "screenshots": "vitest run --config vitest.screens.config.ts",
    "smoke:yoga": "tsx scripts/smoke-yoga.ts",
    "test:https-lab": "vitest run --config vitest.proxy.config.ts",
    "speech:file": "node dist/speech-cli.js",
    "test:speech": "vitest run test/speech-command.test.ts test/speech-harness.test.ts",
    "speech:demo": "tsx test/support/speech-demo.ts",
    "knowledge": "node dist/knowledge-cli.js",
    "lab:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mixai-lab.ps1",
    "lab:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mixai-lab.ps1 -CheckOnly"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.8",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "rxjs": "^7.8.2",
    "soundcraft-ui-connection": "7.1.0",
    "unpdf": "2.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "mixai": "dist/index.js",
    "mixai-server": "dist/serve.js"
  },
  "engines": {
    "node": ">=22"
  }
}
